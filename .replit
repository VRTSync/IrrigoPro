modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "wc-in-flight-photos"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "validate-api-billing"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "validate-api-field"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "validate-web"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "validate-types"

[[workflows.workflow]]
name = "wc-in-flight-photos"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/irrigopro && npx vitest run src/pages/wet-checks-in-flight-photos.test.tsx"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "validate-api-billing"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node scripts/run-validation-lane.mjs api-billing"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "validate-api-field"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node scripts/run-validation-lane.mjs api-field"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "validate-web"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node scripts/run-validation-lane.mjs web"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "validate-types"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node scripts/run-validation-lane.mjs types"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 600000

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 8082
externalPort = 6000

[[ports]]
localPort = 18522
externalPort = 3003

[[ports]]
localPort = 21025
externalPort = 3000

[[ports]]
localPort = 21209
externalPort = 3001

[[ports]]
localPort = 23333
externalPort = 3002

[[ports]]
localPort = 23334
externalPort = 5173

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
USE_DB_OAUTH_STATE = "1"
SENDGRID_FROM_EMAIL = "info@highplainsprop.com"
